{
  "appId": "fr.motorauto.app",
  "appName": "MOTORAUTO",
  "webDir": "www",
  "backgroundColor": "#09090b",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "server": {
    "allowNavigation": ["motorauto.fr", "*.motorauto.fr", "motorautoireyv.firebaseapp.com"]
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "backgroundColor": "#09090b" },
    "StatusBar": { "style": "DARK", "backgroundColor": "#09090b" },
    "FirebaseAuthentication": { "skipNativeAuth": true, "providers": ["google.com", "apple.com"] },
    "FirebaseMessaging": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
