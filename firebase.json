{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "*.rules",
      "README.md",
      "tests/**",
      "app-ios/**",
      "functions/**",
      "index.src.html",
      "vercel.json",
      ".vercelignore",
      "data/**",
      "pages/**",
      "docs/**",
      "*.md"
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node scripts/sync-functions.js",
      "npm test"
    ]
  }
}
